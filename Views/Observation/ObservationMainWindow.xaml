                                <CheckBox x:Name="ChkBGOFit" Content="Curve Fitting" Margin="0,0,8,0"
                                          Style="{StaticResource MaterialDesignCheckBox}"
                                          Checked="ChkBGOFit_Changed" Unchecked="ChkBGOFit_Changed"/>
                                <ComboBox x:Name="CmbBGOFitMethod" Width="110" Margin="0,0,0,0"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          SelectionChanged="CmbBGOFitMethod_SelectionChanged">
                                    <ComboBoxItem Content="Gaussian" IsSelected="True"/>
                                    <ComboBoxItem Content="Lorentzian"/>
                                </ComboBox>
                            </StackPanel>
                            
