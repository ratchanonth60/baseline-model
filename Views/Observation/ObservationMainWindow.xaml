                                    <ComboBoxItem Content="Layer 5"/>
                                </ComboBox>
                                
                                <TextBlock Text="X Min:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="TxtBGOXMin" Text="0" Width="70" Margin="0,0,16,0"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
