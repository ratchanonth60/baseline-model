<Window x:Class="BaselineMode.WPF.Presentation.Views.Flux.FluxMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fluxViews="clr-namespace:BaselineMode.WPF.Presentation.Views.Flux"
        xmlns:scott="clr-namespace:ScottPlot;assembly=ScottPlot.WPF"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Flux Mode - DSSD Analysis Suite" 
        Height="950" Width="1700"
        WindowState="Maximized"
        Background="#1E1E1E">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Colors.xaml"/>
                <ResourceDictionary Source="../Resources/Styles.xaml"/>
                <ResourceDictionary Source="../Resources/Buttons.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ TOP TOOLBAR ═══ -->
        <Border Background="#252526" Padding="12,8" Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Title -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Flash" Width="28" Height="28" Foreground="#FF9800" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Flux Mode" FontSize="20" FontWeight="Bold" Foreground="#FF9800" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Center: File Operations -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="📁 Select Files" Command="{Binding SelectFilesCommand}" 
                            Style="{StaticResource ActionButton}" Margin="4,0" Padding="12,6"/>
                    <Button Content="⚙ Process Data" Command="{Binding ProcessDataCommand}" 
                            Style="{StaticResource ActionButton}" Margin="4,0" Padding="12,6"/>
                    <Button Content="📊 Read Data" Command="{Binding ReadDataCommand}" 
                            Style="{StaticResource ActionButton}" Margin="4,0" Padding="12,6"/>
                    <Button Content="🔍 Header Check" Command="{Binding HeaderCheckCommand}" 
                            Style="{StaticResource ActionButton}" Margin="4,0" Padding="12,6"/>
                    
                    <Rectangle Width="1" Fill="#3E3E42" Margin="12,4"/>

                    <Button Content="⏹ Stop" Command="{Binding StopCommand}" 
                            Margin="4,0" Padding="12,6" Foreground="#FF5252"
                            Background="#3E3E42" BorderThickness="0"/>
                    <Button Content="🔄 Reset" Command="{Binding ResetCommand}" 
                            Margin="4,0" Padding="12,6" Foreground="#FFD740"
                            Background="#3E3E42" BorderThickness="0"/>
                </StackPanel>

                <!-- Right: Settings -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Time Range:" Foreground="#858585" FontSize="12" VerticalAlignment="Center" Margin="8,0,4,0"/>
                    <TextBox x:Name="TimeRangeBox" Text="{Binding TimeRangeMax, UpdateSourceTrigger=PropertyChanged}" 
                             Width="60" Background="#3E3E42" Foreground="White" BorderBrush="#555" 
                             Padding="4,2" VerticalAlignment="Center"/>
                    
                    <CheckBox Content="Log Scale" IsChecked="{Binding IsLogScale}" 
                              Foreground="#4EC9B0" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ MAIN CONTENT ═══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── LEFT PANEL: Info & Settings ── -->
            <Border Background="#252526" Margin="4" Padding="12" CornerRadius="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- File Info -->
                        <TextBlock Text="File Information" Foreground="#FF9800" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding InputFilesInfo}" Foreground="#B0BEC5" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding OutputFileName, StringFormat='Output: {0}'}" Foreground="#858585" FontSize="11" Margin="0,0,0,12"/>

                        <Rectangle Height="1" Fill="#3E3E42" Margin="0,4,0,12"/>

                        <!-- Output File Name -->
                        <TextBlock Text="Output File Name" Foreground="#858585" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding OutputFileName, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="#3E3E42" Foreground="White" BorderBrush="#555" Padding="6,4" Margin="0,0,0,12"/>

                        <Rectangle Height="1" Fill="#3E3E42" Margin="0,4,0,12"/>

                        <!-- Test Conditions -->
                        <TextBlock Text="Test Conditions" Foreground="#FF9800" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Delay Time:" Foreground="#858585" FontSize="12" Width="90" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding DelayTime, UpdateSourceTrigger=PropertyChanged}" 
                                     Width="70" Background="#3E3E42" Foreground="White" BorderBrush="#555" Padding="4,2"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Threshold:" Foreground="#858585" FontSize="12" Width="90" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Threshold, UpdateSourceTrigger=PropertyChanged}" 
                                     Width="70" Background="#3E3E42" Foreground="White" BorderBrush="#555" Padding="4,2"/>
                        </StackPanel>

                        <Rectangle Height="1" Fill="#3E3E42" Margin="0,4,0,12"/>

                        <!-- Time Info -->
                        <TextBlock Text="Time Information" Foreground="#FF9800" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                        <StackPanel Margin="0,0,0,4">
                            <TextBlock Foreground="#858585" FontSize="11">
                                <Run Text="Start: "/>
                                <Run Text="{Binding StartTimeText}" Foreground="#69F0AE"/>
                            </TextBlock>
                            <TextBlock Foreground="#858585" FontSize="11" Margin="0,2,0,0">
                                <Run Text="Stop: "/>
                                <Run Text="{Binding StopTimeText}" Foreground="#FF5252"/>
                            </TextBlock>
                            <TextBlock Foreground="#858585" FontSize="11" Margin="0,2,0,0">
                                <Run Text="Duration: "/>
                                <Run Text="{Binding DurationText}" Foreground="#FFD740"/>
                            </TextBlock>
                            <TextBlock Foreground="#858585" FontSize="11" Margin="0,2,0,0">
                                <Run Text="Data Count: "/>
                                <Run Text="{Binding DataCount}" Foreground="#26C6DA"/>
                            </TextBlock>
                        </StackPanel>

                        <Rectangle Height="1" Fill="#3E3E42" Margin="0,8,0,12"/>

                        <!-- Header Check -->
                        <TextBlock Text="Header Validation" Foreground="#FF9800" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding HeaderCheckStatus}" Foreground="#69F0AE" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <Rectangle Height="1" Fill="#3E3E42" Margin="0,4,0,12"/>

                        <!-- Header Info -->
                        <TextBlock Text="Header Information" Foreground="#FF9800" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding HeaderInfo, Mode=OneWay}" IsReadOnly="True" 
                                 Background="#1E1E1E" Foreground="#B0BEC5" BorderThickness="0"
                                 TextWrapping="Wrap" FontSize="10" FontFamily="Consolas"
                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 MinHeight="100"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ── RIGHT PANEL: Plots ── -->
            <fluxViews:FluxView Grid.Column="1" DataContext="{Binding}" Margin="4"/>
        </Grid>

        <!-- ═══ BOTTOM STATUS BAR ═══ -->
        <Border Grid.Row="2" Background="#007ACC" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="White" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <ProgressBar Value="{Binding ProgressValue}" Width="200" Height="14" 
                                 Background="#005A9E" Foreground="#69F0AE" VerticalAlignment="Center"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>

                <TextBlock Grid.Column="1" x:Name="DateTimeLabel" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>