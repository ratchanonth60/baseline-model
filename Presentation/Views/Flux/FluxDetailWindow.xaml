<Window x:Class="BaselineMode.WPF.Presentation.Views.Flux.FluxDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:scott="clr-namespace:ScottPlot;assembly=ScottPlot.WPF"
        mc:Ignorable="d"
        Title="Flux Detail View" 
        Height="650" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <Border Background="#252526" Padding="16,12">
            <TextBlock x:Name="TitleText" Text="" 
                       FontSize="18" FontWeight="SemiBold" 
                       Foreground="#4EC9B0"/>
        </Border>

        <!-- Plot -->
        <scott:WpfPlot x:Name="DetailPlot" Grid.Row="1" Margin="12"/>

        <!-- Stats Footer -->
        <Border Grid.Row="2" Background="#252526" Padding="16,12">
            <WrapPanel>
                <TextBlock Text="Data Points:" Foreground="#858585" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtDataPoints" Text="-" Foreground="#26C6DA" FontSize="12" FontWeight="Bold" Margin="0,0,16,0" VerticalAlignment="Center"/>
                <TextBlock Text="Max Flux:" Foreground="#858585" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtMaxFlux" Text="-" Foreground="#FF5252" FontSize="12" FontWeight="Bold" Margin="0,0,16,0" VerticalAlignment="Center"/>
                <TextBlock Text="Mean Flux:" Foreground="#858585" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtMeanFlux" Text="-" Foreground="#69F0AE" FontSize="12" FontWeight="Bold" Margin="0,0,16,0" VerticalAlignment="Center"/>
                <TextBlock Text="Time Range:" Foreground="#858585" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtTimeRange" Text="-" Foreground="#FFD740" FontSize="12" FontWeight="Bold" Margin="0,0,16,0" VerticalAlignment="Center"/>
                <CheckBox x:Name="ChkLogScale" Content="Log Scale" IsChecked="False" Foreground="#4EC9B0" VerticalAlignment="Center"/>
            </WrapPanel>
        </Border>
    </Grid>
</Window>