<Window x:Class="BaselineMode.WPF.Views.Shared.ModeSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="DSSD Analysis Suite"
        Height="500" Width="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Style="{StaticResource MaterialDesignWindow}"
        Background="{DynamicResource MaterialDesign.Brush.Background}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <materialDesign:ColorZone Mode="PrimaryDark" Padding="20" Grid.Row="0">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="DSSD Analysis Suite" 
                           FontSize="28" FontWeight="Bold" 
                           HorizontalAlignment="Center"
                           Foreground="White"/>
                <TextBlock Text="Double-Sided Silicon Strip Detector Data Analysis"
                           FontSize="14" 
                           HorizontalAlignment="Center"
                           Foreground="#B0BEC5"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </materialDesign:ColorZone>

        <!-- Mode Selection Cards -->
        <Grid Grid.Row="1" Margin="30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Baseline Mode Card -->
            <materialDesign:Card Grid.Column="0" 
                                 UniformCornerRadius="12"
                                 materialDesign:ElevationAssist.Elevation="Dp4"
                                 Cursor="Hand"
                                 x:Name="BaselineModeCard"
                                 MouseLeftButtonUp="BaselineModeCard_Click">
                <materialDesign:Card.Style>
                    <Style TargetType="materialDesign:Card">
                        <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Card.Background}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E3F2FD"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </materialDesign:Card.Style>
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <materialDesign:PackIcon Kind="ChartLine" 
                                             Width="64" Height="64" 
                                             HorizontalAlignment="Center"
                                             Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                             Grid.Row="0"/>
                    
                    <TextBlock Text="Baseline Mode" 
                               FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,15,0,10"
                               Grid.Row="1"/>
                    
                    <StackPanel Grid.Row="2" Margin="0,10">
                        <TextBlock Text="• Energy Calibration Analysis" FontSize="13" Margin="0,3"/>
                        <TextBlock Text="• Baseline Correction" FontSize="13" Margin="0,3"/>
                        <TextBlock Text="• Gaussian &amp; HEMG Fitting" FontSize="13" Margin="0,3"/>
                        <TextBlock Text="• Multi-Channel Processing" FontSize="13" Margin="0,3"/>
                        <TextBlock Text="• Excel Data Export" FontSize="13" Margin="0,3"/>
                    </StackPanel>

                    <Button Content="Launch Baseline Mode" 
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            materialDesign:ButtonAssist.CornerRadius="20"
                            HorizontalAlignment="Stretch"
                            Height="40"
                            FontSize="14"
                            Click="BaselineMode_Click"
                            Grid.Row="3"/>
                </Grid>
            </materialDesign:Card>

            <!-- Observation Mode Card -->
            <materialDesign:Card Grid.Column="2" 
                                 UniformCornerRadius="12"
                                 materialDesign:ElevationAssist.Elevation="Dp4"
                                 Cursor="Hand"
                                 x:Name="ObservationModeCard"
                                 MouseLeftButtonUp="ObservationModeCard_Click">
                <materialDesign:Card.Style>
                    <Style TargetType="materialDesign:Card">
                        <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Card.Background}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E8F5E9"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </materialDesign:Card.Style>
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <materialDesign:PackIcon Kind="Microscope" 
                                             Width="64" Height="64" 
                                             HorizontalAlignment="Center"
                                             Foreground="#4CAF50"
                                             Grid.Row="0"/>
                    
                    <TextBlock Text="Observation Mode" 
                               FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,15,0,10"
                               Grid.Row="1"/>
                    
                    <StackPanel Grid.Row="2" Margin="0,10">
                        <TextBlock Text="• Real-time Particle Detection" FontSize="13" Margin="0,3"/>
                        <TextBlock Text="• DSSD &amp; BGO Layer Analysis" FontSize="13" Margin="0,3"/>
                        <TextBlock Text="• Strip-by-Strip Histograms" FontSize="13" Margin="0,3"/>
                        <TextBlock Text="• Kalman Filtering" FontSize="13" Margin="0,3"/>
                        <TextBlock Text="• Live Data Visualization" FontSize="13" Margin="0,3"/>
                    </StackPanel>

                    <Button Content="Launch Observation Mode" 
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#4CAF50"
                            materialDesign:ButtonAssist.CornerRadius="20"
                            HorizontalAlignment="Stretch"
                            Height="40"
                            FontSize="14"
                            Click="ObservationMode_Click"
                            Grid.Row="3"/>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#F5F5F5" Padding="15">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="Version 1.4.0 - Combined DSSD Analysis Suite" 
                           FontSize="12" 
                           Foreground="#757575"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Select a mode to begin analysis" 
                           FontSize="11" 
                           Foreground="#9E9E9E"
                           HorizontalAlignment="Center"
                           Margin="0,3,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
