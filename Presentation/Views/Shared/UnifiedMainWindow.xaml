                                        </Popup>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="Data Bg:" Foreground="#CCCCCC" FontSize="11" Width="55" VerticalAlignment="Center"/>
                                        <ToggleButton x:Name="ToggleBaseDataBg" Width="50" Height="20" BorderBrush="#3E3E42" Background="Transparent" Padding="0">
                                            <Rectangle Width="40" Height="14" Stroke="#858585" StrokeThickness="1">
                                                <Rectangle.Fill>
                                                    <SolidColorBrush Color="{Binding GraphDataColor}" />
                                                </Rectangle.Fill>
                                            </Rectangle>
                                        </ToggleButton>
                                        <Popup IsOpen="{Binding IsChecked, ElementName=ToggleBaseDataBg}" StaysOpen="False" PlacementTarget="{Binding ElementName=ToggleBaseDataBg}" AllowsTransparency="True" PopupAnimation="Fade">
                                            <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="3" Padding="8">
                                                <materialDesign:ColorPicker Color="{Binding GraphDataColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="300" Height="200" />
                                            </Border>
                                        </Popup>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="Series:" Foreground="#CCCCCC" FontSize="11" Width="55" VerticalAlignment="Center"/>
                                        <ToggleButton x:Name="ToggleBaseSeries" Width="50" Height="20" BorderBrush="#3E3E42" Background="Transparent" Padding="0">
                                            <Rectangle Width="40" Height="14" Stroke="#858585" StrokeThickness="1">
                                                <Rectangle.Fill>
                                                    <SolidColorBrush Color="{Binding GraphSeriesColor}" />
                                                </Rectangle.Fill>
                                            </Rectangle>
                                        </ToggleButton>
                                        <Popup IsOpen="{Binding IsChecked, ElementName=ToggleBaseSeries}" StaysOpen="False" PlacementTarget="{Binding ElementName=ToggleBaseSeries}" AllowsTransparency="True" PopupAnimation="Fade">
                                            <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="3" Padding="8">
                                                <materialDesign:ColorPicker Color="{Binding GraphSeriesColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="300" Height="200" />
                                            </Border>
                                        </Popup>
                                    </StackPanel>
                                    
                                     <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="Text:" Foreground="#CCCCCC" FontSize="11" Width="55" VerticalAlignment="Center"/>
                                        <ToggleButton x:Name="ToggleBaseText" Width="50" Height="20" BorderBrush="#3E3E42" Background="Transparent" Padding="0">
                                            <Rectangle Width="40" Height="14" Stroke="#858585" StrokeThickness="1">
                                                <Rectangle.Fill>
                                                    <SolidColorBrush Color="{Binding GraphTextColor}" />
                                                </Rectangle.Fill>
                                            </Rectangle>
                                        </ToggleButton>
                                        <Popup IsOpen="{Binding IsChecked, ElementName=ToggleBaseText}" StaysOpen="False" PlacementTarget="{Binding ElementName=ToggleBaseText}" AllowsTransparency="True" PopupAnimation="Fade">
                                            <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="3" Padding="8">
                                                <materialDesign:ColorPicker Color="{Binding GraphTextColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="300" Height="200" />
                                            </Border>
                                        </Popup>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="Baseline Graph" Foreground="#858585" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- CalibrationVM Group -->
                        <Border BorderBrush="#3E3E42" BorderThickness="0,0,1,0" Padding="12,0">
                            <StackPanel>
                                <StackPanel VerticalAlignment="Center" Height="68">
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="Fig Bg:" Foreground="#CCCCCC" FontSize="11" Width="55" VerticalAlignment="Center"/>
                                        <ToggleButton x:Name="ToggleCalibFigBg" Width="50" Height="20" BorderBrush="#3E3E42" Background="Transparent" Padding="0">
                                            <Rectangle Width="40" Height="14" Stroke="#858585" StrokeThickness="1">
                                                <Rectangle.Fill>
                                                    <SolidColorBrush Color="{Binding CalibrationVM.GraphFigureColor}" />
                                                </Rectangle.Fill>
                                            </Rectangle>
                                        </ToggleButton>
                                        <Popup IsOpen="{Binding IsChecked, ElementName=ToggleCalibFigBg}" StaysOpen="False" PlacementTarget="{Binding ElementName=ToggleCalibFigBg}" AllowsTransparency="True" PopupAnimation="Fade">
                                            <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="3" Padding="8">
                                                <materialDesign:ColorPicker Color="{Binding CalibrationVM.GraphFigureColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="300" Height="200" />
                                            </Border>
                                        </Popup>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="Data Bg:" Foreground="#CCCCCC" FontSize="11" Width="55" VerticalAlignment="Center"/>
                                        <ToggleButton x:Name="ToggleCalibDataBg" Width="50" Height="20" BorderBrush="#3E3E42" Background="Transparent" Padding="0">
                                            <Rectangle Width="40" Height="14" Stroke="#858585" StrokeThickness="1">
                                                <Rectangle.Fill>
                                                    <SolidColorBrush Color="{Binding CalibrationVM.GraphDataColor}" />
                                                </Rectangle.Fill>
                                            </Rectangle>
                                        </ToggleButton>
                                        <Popup IsOpen="{Binding IsChecked, ElementName=ToggleCalibDataBg}" StaysOpen="False" PlacementTarget="{Binding ElementName=ToggleCalibDataBg}" AllowsTransparency="True" PopupAnimation="Fade">
                                            <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="3" Padding="8">
                                                <materialDesign:ColorPicker Color="{Binding CalibrationVM.GraphDataColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="300" Height="200" />
                                            </Border>
                                        </Popup>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="Series:" Foreground="#CCCCCC" FontSize="11" Width="55" VerticalAlignment="Center"/>
                                        <ToggleButton x:Name="ToggleCalibSeries" Width="50" Height="20" BorderBrush="#3E3E42" Background="Transparent" Padding="0">
                                            <Rectangle Width="40" Height="14" Stroke="#858585" StrokeThickness="1">
                                                <Rectangle.Fill>
                                                    <SolidColorBrush Color="{Binding CalibrationVM.GraphSeriesColor}" />
                                                </Rectangle.Fill>
                                            </Rectangle>
                                        </ToggleButton>
                                        <Popup IsOpen="{Binding IsChecked, ElementName=ToggleCalibSeries}" StaysOpen="False" PlacementTarget="{Binding ElementName=ToggleCalibSeries}" AllowsTransparency="True" PopupAnimation="Fade">
                                            <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="3" Padding="8">
                                                <materialDesign:ColorPicker Color="{Binding CalibrationVM.GraphSeriesColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="300" Height="200" />
                                            </Border>
                                        </Popup>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="Text:" Foreground="#CCCCCC" FontSize="11" Width="55" VerticalAlignment="Center"/>
                                        <ToggleButton x:Name="ToggleCalibText" Width="50" Height="20" BorderBrush="#3E3E42" Background="Transparent" Padding="0">
                                            <Rectangle Width="40" Height="14" Stroke="#858585" StrokeThickness="1">
                                                <Rectangle.Fill>
                                                    <SolidColorBrush Color="{Binding CalibrationVM.GraphTextColor}" />
                                                </Rectangle.Fill>
                                            </Rectangle>
                                        </ToggleButton>
                                        <Popup IsOpen="{Binding IsChecked, ElementName=ToggleCalibText}" StaysOpen="False" PlacementTarget="{Binding ElementName=ToggleCalibText}" AllowsTransparency="True" PopupAnimation="Fade">
                                            <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="3" Padding="8">
                                                <materialDesign:ColorPicker Color="{Binding CalibrationVM.GraphTextColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="300" Height="200" />
                                            </Border>
                                        </Popup>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="Calibration Graph" Foreground="#858585" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Output Group -->
                        <Border Padding="12,0">
                            <StackPanel>
                                <StackPanel VerticalAlignment="Center" Height="68">
                                    <TextBlock Text="Output Folder Root:" Foreground="#CCCCCC" FontSize="11" Margin="0,4,0,4"/>
                                    <Grid Width="200">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding OutputDirectoryPath, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource RibbonInput}" IsReadOnly="True" ToolTip="{Binding OutputDirectoryPath}"/>
                                        <Button Grid.Column="1" Content="..." Style="{StaticResource RibbonBtnSmall}" 
                                                Command="{Binding BrowseOutputDirectoryCommand}" Margin="2,0,0,0" Padding="0"/>
                                    </Grid>

                                    <TextBlock Text="Output Filename:" Foreground="#CCCCCC" FontSize="11" Margin="0,4,0,4"/>
                                    <TextBox Text="{Binding OutputFileName, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{StaticResource RibbonInput}" Width="200"/>
                                </StackPanel>
                                <TextBlock Text="Output" Foreground="#858585" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 3. Main Content -->
        <Grid Grid.Row="2" Background="#1E1E1E">
            <!-- BASELINE View -->
            <Grid x:Name="ViewBaseline">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Workspace Toolbar -->
                <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="0,0,0,1">
                    <Grid Margin="16,0">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnViewHistogram" Style="{StaticResource WorkspaceTabBtnActive}" Content="Histogram Grid" Click="BtnViewHistogram_Click"/>
                            <Button x:Name="BtnViewDataTable" Style="{StaticResource WorkspaceTabBtn}" Content="Data Table" Click="BtnViewDataTable_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtFileInfo" Text="{Binding InputFilesInfo}" Foreground="#858585" FontSize="10" 
                                   HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="400" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>

                <!-- Content Area -->
                <Grid Grid.Row="1">
                    <!-- Histogram Grid View -->
                    <ScrollViewer x:Name="HistogramView" VerticalScrollBarVisibility="Auto" Padding="16">
                        <TabControl Background="Transparent" BorderThickness="0">
                            <TabControl.Resources>
                                <Style TargetType="TabItem">
                                    <Setter Property="Foreground" Value="#858585"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Padding" Value="12,6"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TabItem">
                                                <Border x:Name="border" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter ContentSource="Header"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="border" Property="BorderBrush" Value="#007ACC"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TabControl.Resources>
                            
                            <!-- X-Direction Tab -->
                            <TabItem Header="X-Direction (Ch 1-8)">
                                <ItemsControl ItemsSource="{Binding ChannelsX}" Margin="0,12,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="2" Columns="4"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ChartCard}" Margin="6" MinHeight="180">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftDoubleClick" 
                                                                  Command="{Binding DataContext.ShowChannelDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                  CommandParameter="{Binding}"/>
                                                </Border.InputBindings>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid Margin="0,0,0,4">
                                                        <TextBlock Text="{Binding Title}" Foreground="#CCCCCC" FontSize="11" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding StatsText}" Foreground="#007ACC" FontSize="10" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                    <scott:WpfPlot Grid.Row="1" x:Name="WpfPlot" Loaded="WpfPlot_Loaded" Tag="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </TabItem>
                            
                            <!-- Z-Direction Tab -->
                            <TabItem Header="Z-Direction (Ch 9-16)">
                                <ItemsControl ItemsSource="{Binding ChannelsZ}" Margin="0,12,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="2" Columns="4"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ChartCard}" Margin="6" MinHeight="180">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftDoubleClick" 
                                                                  Command="{Binding DataContext.ShowChannelDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                  CommandParameter="{Binding}"/>
                                                </Border.InputBindings>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid Margin="0,0,0,4">
                                                        <TextBlock Text="{Binding Title}" Foreground="#CCCCCC" FontSize="11" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding StatsText}" Foreground="#007ACC" FontSize="10" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                    <scott:WpfPlot Grid.Row="1" x:Name="WpfPlot" Loaded="WpfPlot_Loaded" Tag="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </TabItem>
                        </TabControl>
                    </ScrollViewer>

                    <!-- Data Table View -->
                    <Grid x:Name="DataTableView" Visibility="Collapsed" Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DataGrid ItemsSource="{Binding DisplayDataTable}" AutoGenerateColumns="True" 
                                  Background="#252526" Foreground="#CCCCCC" BorderBrush="#3E3E42"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                  RowBackground="#252526" AlternatingRowBackground="#2D2D2D"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                            <Button Content="◀ Prev" Command="{Binding PreviousPageCommand}" 
                                    Style="{StaticResource RibbonBtnSmall}" Padding="12,6" Background="#3E3E42"/>
                            <TextBlock Text="{Binding PageInfoText}" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="16,0" FontWeight="SemiBold"/>
                            <Button Content="Next ▶" Command="{Binding NextPageCommand}" 
                                    Style="{StaticResource RibbonBtnSmall}" Padding="12,6" Background="#3E3E42"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <!-- OBSERVATION View -->
            <Grid x:Name="ViewObservation" Visibility="Collapsed">
                <!-- Inner TabControl for DSSD/BGO views -->
                <TabControl Background="Transparent" BorderThickness="0" TabStripPlacement="Left">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Foreground" Value="#858585"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Padding" Value="10,12"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border x:Name="border" Background="Transparent" BorderThickness="2,0,0,0" 
                                                BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter ContentSource="Header"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="border" Property="BorderBrush" Value="#007ACC"/>
                                                <Setter TargetName="border" Property="Background" Value="#2B2D31"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#35373B"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>

                    <!-- Tab 1: DSSD Pulse Height -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel>
                                <materialDesign:PackIcon Kind="ChartBar" Width="20" Height="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="DSSD" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </TabItem.Header>
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Pulse Height X -->
                            <Border Style="{StaticResource ChartCard}" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Pulse Height X" Foreground="#4EC9B0" FontSize="13" FontWeight="SemiBold" Margin="8,4"/>
                                    <scott:WpfPlot x:Name="ObsPlotDSSDX" Grid.Row="1" MouseDoubleClick="ObsPlot_MouseDoubleClick" Tag="PulseHeight_X"/>
                                    <WrapPanel Grid.Row="2" Margin="8,6,8,4">
                                        <TextBlock Text="Peak:" Foreground="#858585" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ObsTxtDSSDXPeak" Text="-" Foreground="#FF5252" FontSize="10" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Counts:" Foreground="#858585" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ObsTxtDSSDXCounts" Text="-" Foreground="#B388FF" FontSize="10" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Mean:" Foreground="#858585" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ObsTxtDSSDXMean" Text="-" Foreground="#69F0AE" FontSize="10" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="RMS:" Foreground="#858585" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ObsTxtDSSDXRMS" Text="-" Foreground="#FFD740" FontSize="10" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="FWHM:" Foreground="#858585" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ObsTxtDSSDXFWHM" Text="-" Foreground="#40C4FF" FontSize="10" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Res:" Foreground="#858585" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ObsTxtDSSDXRes" Text="-" Foreground="#FF80AB" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </WrapPanel>
                                </Grid>
                            </Border>
                            <!-- Pulse Height Y -->
                            <Border Grid.Row="1" Style="{StaticResource ChartCard}" Margin="0,6,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Pulse Height Y" Foreground="#4EC9B0" FontSize="13" FontWeight="SemiBold" Margin="8,4"/>
                                    <scott:WpfPlot x:Name="ObsPlotDSSDY" Grid.Row="1" MouseDoubleClick="ObsPlot_MouseDoubleClick" Tag="PulseHeight_Y"/>
                                    <WrapPanel Grid.Row="2" Margin="8,6,8,4">
                                        <TextBlock Text="Peak:" Foreground="#858585" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ObsTxtDSSDYPeak" Text="-" Foreground="#FF5252" FontSize="10" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Counts:" Foreground="#858585" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ObsTxtDSSDYCounts" Text="-" Foreground="#B388FF" FontSize="10" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Mean:" Foreground="#858585" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ObsTxtDSSDYMean" Text="-" Foreground="#69F0AE" FontSize="10" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="RMS:" Foreground="#858585" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ObsTxtDSSDYRMS" Text="-" Foreground="#FFD740" FontSize="10" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="FWHM:" Foreground="#858585" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ObsTxtDSSDYFWHM" Text="-" Foreground="#40C4FF" FontSize="10" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Res:" Foreground="#858585" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ObsTxtDSSDYRes" Text="-" Foreground="#FF80AB" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- Tab 2: Histogram X Strip -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel>
                                <materialDesign:PackIcon Kind="ChartBarStacked" Width="20" Height="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="X Strip" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <UniformGrid Columns="2" Rows="4" Margin="8">
                                <!-- Strip X1-X8 -->
                                <Border Style="{StaticResource ChartCard}" Margin="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <scott:WpfPlot x:Name="ObsPlotStripX1" MinHeight="140" Tag="StripX_1" MouseDoubleClick="ObsPlot_MouseDoubleClick"/>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" MinWidth="90">
                                            <TextBlock Text="X1" FontWeight="Bold" Foreground="#26C6DA" FontSize="12"/>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="Peak:" Foreground="#858585" FontSize="9" Margin="0,0,3,0"/><TextBlock x:Name="ObsTxtX1Peak" Text="-" Foreground="#FF5252" FontSize="9"/></StackPanel>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="Counts:" Foreground="#858585" FontSize="9" Margin="0,0,3,0"/><TextBlock x:Name="ObsTxtX1Counts" Text="-" Foreground="#B388FF" FontSize="9"/></StackPanel>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="Mean:" Foreground="#858585" FontSize="9" Margin="0,0,3,0"/><TextBlock x:Name="ObsTxtX1Mean" Text="-" Foreground="#69F0AE" FontSize="9"/></StackPanel>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="RMS:" Foreground="#858585" FontSize="9" Margin="0,0,3,0"/><TextBlock x:Name="ObsTxtX1RMS" Text="-" Foreground="#FFD740" FontSize="9"/></StackPanel>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="FWHM:" Foreground="#858585" FontSize="9" Margin="0,0,3,0"/><TextBlock x:Name="ObsTxtX1FWHM" Text="-" Foreground="#40C4FF" FontSize="9"/></StackPanel>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="Res:" Foreground="#858585" FontSize="9" Margin="0,0,3,0"/><TextBlock x:Name="ObsTxtX1Res" Text="-" Foreground="#FF80AB" FontSize="9"/></StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource ChartCard}" Margin="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <scott:WpfPlot x:Name="ObsPlotStripX2" MinHeight="140" Tag="StripX_2" MouseDoubleClick="ObsPlot_MouseDoubleClick"/>
