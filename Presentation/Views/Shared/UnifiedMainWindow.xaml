                                            <StackPanel Orientation="Horizontal"><TextBlock Text="RMS:" Foreground="#858585" FontSize="9" Margin="0,0,3,0"/><TextBlock x:Name="ObsTxtY6RMS" Text="-" Foreground="#FFD740" FontSize="9"/></StackPanel>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="FWHM:" Foreground="#858585" FontSize="9" Margin="0,0,3,0"/><TextBlock x:Name="ObsTxtY6FWHM" Text="-" Foreground="#40C4FF" FontSize="9"/></StackPanel>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="Res:" Foreground="#858585" FontSize="9" Margin="0,0,3,0"/><TextBlock x:Name="ObsTxtY6Res" Text="-" Foreground="#FF80AB" FontSize="9"/></StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource ChartCard}" Margin="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <scott:WpfPlot x:Name="ObsPlotStripY7" MinHeight="140" Tag="StripY_7" MouseDoubleClick="ObsPlot_MouseDoubleClick"/>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" MinWidth="90">
                                            <TextBlock Text="Y7" FontWeight="Bold" Foreground="#26C6DA" FontSize="12"/>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="Peak:" Foreground="#858585" FontSize="9" Margin="0,0,3,0"/><TextBlock x:Name="ObsTxtY7Peak" Text="-" Foreground="#FF5252" FontSize="9"/></StackPanel>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="Counts:" Foreground="#858585" FontSize="9" Margin="0,0,3,0"/><TextBlock x:Name="ObsTxtY7Counts" Text="-" Foreground="#B388FF" FontSize="9"/></StackPanel>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="Mean:" Foreground="#858585" FontSize="9" Margin="0,0,3,0"/><TextBlock x:Name="ObsTxtY7Mean" Text="-" Foreground="#69F0AE" FontSize="9"/></StackPanel>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="RMS:" Foreground="#858585" FontSize="9" Margin="0,0,3,0"/><TextBlock x:Name="ObsTxtY7RMS" Text="-" Foreground="#FFD740" FontSize="9"/></StackPanel>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="FWHM:" Foreground="#858585" FontSize="9" Margin="0,0,3,0"/><TextBlock x:Name="ObsTxtY7FWHM" Text="-" Foreground="#40C4FF" FontSize="9"/></StackPanel>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="Res:" Foreground="#858585" FontSize="9" Margin="0,0,3,0"/><TextBlock x:Name="ObsTxtY7Res" Text="-" Foreground="#FF80AB" FontSize="9"/></StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource ChartCard}" Margin="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <scott:WpfPlot x:Name="ObsPlotStripY8" MinHeight="140" Tag="StripY_8" MouseDoubleClick="ObsPlot_MouseDoubleClick"/>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" MinWidth="90">
                                            <TextBlock Text="Y8" FontWeight="Bold" Foreground="#26C6DA" FontSize="12"/>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="Peak:" Foreground="#858585" FontSize="9" Margin="0,0,3,0"/><TextBlock x:Name="ObsTxtY8Peak" Text="-" Foreground="#FF5252" FontSize="9"/></StackPanel>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="Counts:" Foreground="#858585" FontSize="9" Margin="0,0,3,0"/><TextBlock x:Name="ObsTxtY8Counts" Text="-" Foreground="#B388FF" FontSize="9"/></StackPanel>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="Mean:" Foreground="#858585" FontSize="9" Margin="0,0,3,0"/><TextBlock x:Name="ObsTxtY8Mean" Text="-" Foreground="#69F0AE" FontSize="9"/></StackPanel>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="RMS:" Foreground="#858585" FontSize="9" Margin="0,0,3,0"/><TextBlock x:Name="ObsTxtY8RMS" Text="-" Foreground="#FFD740" FontSize="9"/></StackPanel>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="FWHM:" Foreground="#858585" FontSize="9" Margin="0,0,3,0"/><TextBlock x:Name="ObsTxtY8FWHM" Text="-" Foreground="#40C4FF" FontSize="9"/></StackPanel>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="Res:" Foreground="#858585" FontSize="9" Margin="0,0,3,0"/><TextBlock x:Name="ObsTxtY8Res" Text="-" Foreground="#FF80AB" FontSize="9"/></StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </UniformGrid>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 4: BGO Analysis -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel>
                                <materialDesign:PackIcon Kind="ChartAreaspline" Width="20" Height="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="BGO" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </TabItem.Header>
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- BGO High Gain -->
                            <Border Style="{StaticResource ChartCard}" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="BGO High Gain" Foreground="#FF8C00" FontSize="13" FontWeight="SemiBold" Margin="8,4"/>
                                    <scott:WpfPlot x:Name="ObsPlotBGOHigh" Grid.Row="1" Tag="BGO_High" MouseDoubleClick="ObsPlot_MouseDoubleClick"/>
                                    <WrapPanel Grid.Row="2" Margin="8,6,8,4">
                                        <TextBlock Text="Peak:" Foreground="#858585" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ObsTxtBGOHPeak" Text="-" Foreground="#FF5252" FontSize="10" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Mean:" Foreground="#858585" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ObsTxtBGOHMean" Text="-" Foreground="#69F0AE" FontSize="10" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="RMS:" Foreground="#858585" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ObsTxtBGOHRMS" Text="-" Foreground="#FFD740" FontSize="10" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="FWHM:" Foreground="#858585" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ObsTxtBGOHFWHM" Text="-" Foreground="#40C4FF" FontSize="10" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Res:" Foreground="#858585" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ObsTxtBGOHRes" Text="-" Foreground="#FF80AB" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </WrapPanel>
                                </Grid>
                            </Border>
                            <!-- BGO Low Gain -->
                            <Border Grid.Row="1" Style="{StaticResource ChartCard}" Margin="0,6,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="BGO Low Gain" Foreground="#FF8C00" FontSize="13" FontWeight="SemiBold" Margin="8,4"/>
                                    <scott:WpfPlot x:Name="ObsPlotBGOLow" Grid.Row="1" Tag="BGO_Low" MouseDoubleClick="ObsPlot_MouseDoubleClick"/>
                                    <WrapPanel Grid.Row="2" Margin="8,6,8,4">
                                        <TextBlock Text="Peak:" Foreground="#858585" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ObsTxtBGOLPeak" Text="-" Foreground="#FF5252" FontSize="10" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Mean:" Foreground="#858585" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ObsTxtBGOLMean" Text="-" Foreground="#69F0AE" FontSize="10" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="RMS:" Foreground="#858585" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ObsTxtBGOLRMS" Text="-" Foreground="#FFD740" FontSize="10" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="FWHM:" Foreground="#858585" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ObsTxtBGOLFWHM" Text="-" Foreground="#40C4FF" FontSize="10" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Res:" Foreground="#858585" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ObsTxtBGOLRes" Text="-" Foreground="#FF80AB" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- CALIBRATION View -->
            <Grid x:Name="ViewCalibration" Visibility="Collapsed">
                 <viewsCalib:CalibrationView DataContext="{Binding CalibrationVM}"/>
            </Grid>

            <!-- FLUX View -->
            <Grid x:Name="ViewFlux" Visibility="Collapsed">
                 <viewsFlux:FluxView DataContext="{Binding FluxVM}"/>
            </Grid>

            <!-- SETTINGS View -->
            <Grid x:Name="ViewSettings" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Settings Panel" Foreground="#858585" FontSize="16"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 4. Status Bar -->
        <Border Grid.Row="3" Background="#007ACC">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="CheckCircle" Width="14" Height="14" Foreground="{Binding StatusColor}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtStatusBar" Text="{Binding StatusMessage}" Foreground="{Binding StatusColor}" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <ProgressBar x:Name="StatusProgressBar" Width="120" Height="6" Value="{Binding ProgressValue}" 
                                 IsIndeterminate="{Binding IsBusy}"
                                 Background="#00000033" Foreground="#FFFFFFCC" BorderThickness="0"/>
                </StackPanel>

                <TextBlock Grid.Column="2" x:Name="ObsDateTimeLabel" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Hidden elements for observation mode -->
        <TextBlock x:Name="ObsTxtFileStatus" Visibility="Collapsed"/>
        <TextBlock x:Name="ObsTxtHeaderStatus" Visibility="Collapsed"/>
        <TextBlock x:Name="ObsTxtDataCount" Visibility="Collapsed"/>
        <TextBlock x:Name="ObsTxtParticleCount" Visibility="Collapsed"/>
        <TextBlock x:Name="ObsTxtStartTime" Visibility="Collapsed"/>
        <TextBlock x:Name="ObsTxtStopTime" Visibility="Collapsed"/>
        <TextBox x:Name="ObsTxtHeaderData" Visibility="Collapsed"/>
    </Grid>
</Window>
