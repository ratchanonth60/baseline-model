<Window x:Class="BaselineMode.WPF.Views.Shared.UnifiedMainWindow"
        x:Name="MainWindowRoot"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:BaselineMode.WPF.Presentation.ViewModels"
        xmlns:viewsCalib="clr-namespace:BaselineMode.WPF.Presentation.Views.Calibration"
        xmlns:viewsFlux="clr-namespace:BaselineMode.WPF.Presentation.Views.Flux"
        xmlns:scott="clr-namespace:ScottPlot;assembly=ScottPlot.WPF"
        mc:Ignorable="d"
        Title="DSSD Analysis Suite"
        Height="900" Width="1600"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Colors.xaml"/>
                <ResourceDictionary Source="../Resources/Styles.xaml"/>
                <ResourceDictionary Source="../Resources/Buttons.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- VS Code Dark Theme Colors -->
            <SolidColorBrush x:Key="WindowBg" Color="#1E1E1E"/>
            <SolidColorBrush x:Key="RibbonBg" Color="#2B2D31"/>
            <SolidColorBrush x:Key="PanelBg" Color="#252526"/>
            <SolidColorBrush x:Key="BorderColor" Color="#3E3E42"/>
            <SolidColorBrush x:Key="PrimaryBlue" Color="#007ACC"/>
            <SolidColorBrush x:Key="AccentTeal" Color="#4EC9B0"/>
            <SolidColorBrush x:Key="TextMain" Color="#CCCCCC"/>
            <SolidColorBrush x:Key="TextMuted" Color="#858585"/>

            <!-- Ribbon Tab Style -->
            <Style x:Key="RibbonTabStyle" TargetType="RadioButton">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#CCCCCC"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="16,6"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="border" Background="{TemplateBinding Background}" 
                                    BorderThickness="1,2,1,0" BorderBrush="Transparent"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#2B2D31"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#007ACC"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Medium"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#35373B"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Large Ribbon Button -->
            <Style x:Key="RibbonBtnLarge" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#CCCCCC"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Width" Value="50"/>
                <Setter Property="Height" Value="56"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" 
                                    CornerRadius="3" Padding="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#3E3E42"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Small Ribbon Button -->
            <Style x:Key="RibbonBtnSmall" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#CCCCCC"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Padding" Value="6,2"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" 
                                    CornerRadius="3" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#3E3E42"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Ribbon Input -->
            <Style x:Key="RibbonInput" TargetType="TextBox">
                <Setter Property="Background" Value="#1E1E1E"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#3E3E42"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="4,2"/>
                <Setter Property="FontSize" Value="11"/>
            </Style>

            <!-- Ribbon ComboBox -->
            <Style x:Key="RibbonCombo" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignComboBox}">
                <Setter Property="Background" Value="#1E1E1E"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#3E3E42"/>
                <Setter Property="FontSize" Value="11"/>
            </Style>

            <!-- Chart Card -->
            <Style x:Key="ChartCard" TargetType="Border">
                <Setter Property="Background" Value="#252526"/>
                <Setter Property="BorderBrush" Value="#3E3E42"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="8"/>
            </Style>

            <!-- Workspace Tab Button -->
            <Style x:Key="WorkspaceTabBtn" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#858585"/>
                <Setter Property="BorderThickness" Value="0,0,0,2"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="WorkspaceTabBtnActive" TargetType="Button" BasedOn="{StaticResource WorkspaceTabBtn}">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#007ACC"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>

        <!-- 1. Title Bar (VS Code Style) -->
        <Border Grid.Row="0" Background="#1E1E1E" BorderBrush="#3E3E42" BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ChartBar" Width="16" Height="16" Foreground="#007ACC" Margin="0,0,8,0"/>
                    <TextBlock Text="DSSD Analysis Suite" Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                
                <TextBlock Grid.Column="2" Text="Workspace: Default" Foreground="#858585" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 2. Ribbon Area -->
        <Border Grid.Row="1" Background="#2B2D31" BorderBrush="#3E3E42" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="90"/>
                </Grid.RowDefinitions>

                <!-- Tab Strip -->
                <StackPanel Orientation="Horizontal" Background="#1E1E1E" Margin="8,4,0,0">
                    <RadioButton x:Name="TabBaseline" Content="Baseline" Style="{StaticResource RibbonTabStyle}" 
                                 IsChecked="True" Checked="TabBaseline_Checked"/>
                    <RadioButton x:Name="TabObservation" Content="Observation" Style="{StaticResource RibbonTabStyle}"
                                 Checked="TabObservation_Checked"/>
                    <RadioButton x:Name="TabCalibration" Content="Calibration" Style="{StaticResource RibbonTabStyle}"
                                 Checked="TabCalibration_Checked"/>
                    <RadioButton x:Name="TabFlux" Content="Flux" Style="{StaticResource RibbonTabStyle}"
                                 Checked="TabFlux_Checked"/>
                    <RadioButton x:Name="TabSettings" Content="Settings" Style="{StaticResource RibbonTabStyle}"
                                 Checked="TabSettings_Checked"/>
                </StackPanel>

                <!-- Toolbar Panels -->
                <Grid Grid.Row="1">
                    <!-- BASELINE Toolbar -->
                    <StackPanel x:Name="ToolbarBaseline" Orientation="Horizontal" Margin="8,4">
                        <!-- File Group -->
                        <Border BorderBrush="#3E3E42" BorderThickness="0,0,1,0" Padding="8,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="68">
                                    <Button Style="{StaticResource RibbonBtnLarge}" Command="{Binding SelectFilesCommand}" ToolTip="Open Files">
                                        <StackPanel>
                                            <materialDesign:PackIcon Kind="FolderOpen" Width="20" Height="20" Foreground="#E8A838" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Open" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <StackPanel VerticalAlignment="Center" Margin="4,0,0,0">
                                        <Button Style="{StaticResource RibbonBtnSmall}" Command="{Binding BrowseOutputDirectoryCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Export" Width="14" Height="14" Foreground="#5B9BD5" Margin="0,0,4,0"/>
                                                <TextBlock Text="Export" FontSize="11"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource RibbonBtnSmall}" Command="{Binding CheckHeaderCommand}" Margin="0,2,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="FileCheck" Width="14" Height="14" Foreground="#4EC9B0" Margin="0,0,4,0"/>
                                                <TextBlock Text="Header" FontSize="11"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="File" Foreground="#858585" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Parameters Group -->
                        <Border BorderBrush="#3E3E42" BorderThickness="0,0,1,0" Padding="12,0">
                            <StackPanel>
                                <StackPanel VerticalAlignment="Center" Height="68">
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="Delay:" Foreground="#CCCCCC" FontSize="11" Width="45" TextAlignment="Right" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding DelayTimeMs, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource RibbonInput}" Width="60" Margin="4,0,0,0"/>
                                        <TextBlock Text="μs" Foreground="#858585" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="Thresh:" Foreground="#CCCCCC" FontSize="11" Width="45" TextAlignment="Right" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding ThresholdValue, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource RibbonInput}" Width="60" Margin="4,0,0,0"/>
                                        <TextBlock Text="mV" Foreground="#858585" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="Parameters" Foreground="#858585" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Fitting Group -->
                        <Border BorderBrush="#3E3E42" BorderThickness="0,0,1,0" Padding="12,0">
                            <StackPanel>
                                <StackPanel VerticalAlignment="Center" Height="68">
                                    <CheckBox IsChecked="{Binding ShowGaussianFit}" Margin="0,6,0,0">
                                        <TextBlock Text="Gaussian Fit" Foreground="#CCCCCC" FontSize="11"/>
                                    </CheckBox>
                                    <CheckBox IsChecked="{Binding ShowHemgSingleFit}" Margin="0,4,0,0">
                                        <TextBlock Text="HEMG Single" Foreground="#CCCCCC" FontSize="11"/>
                                    </CheckBox>
                                    <CheckBox IsChecked="{Binding ShowHemgDoubleFit}" Margin="0,4,0,0">
                                        <TextBlock Text="HEMG Double" Foreground="#CCCCCC" FontSize="11"/>
                                    </CheckBox>
                                    <CheckBox IsChecked="{Binding ShowLorentzianFit}" Margin="0,4,0,0">
                                        <TextBlock Text="Lorentzian" Foreground="#CCCCCC" FontSize="11"/>
                                    </CheckBox>
                                </StackPanel>
                                <TextBlock Text="Fitting" Foreground="#858585" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Action Group -->
                        <Border BorderBrush="#3E3E42" BorderThickness="0,0,1,0" Padding="8,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="68">
                                    <Button Style="{StaticResource RibbonBtnLarge}" Command="{Binding PreProcessDataCommand}" ToolTip="Pre-Process to Excel">
                                        <StackPanel>
                                            <materialDesign:PackIcon Kind="FileExcel" Width="20" Height="20" Foreground="#217346" HorizontalAlignment="Center"/>
                                            <TextBlock Text="PreProc" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource RibbonBtnLarge}" Command="{Binding ProcessDataCommand}" ToolTip="Process Data">
                                        <StackPanel>
                                            <materialDesign:PackIcon Kind="Play" Width="20" Height="20" Foreground="#4CAF50" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Process" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource RibbonBtnLarge}" Command="{Binding StopCommand}" ToolTip="Stop">
                                        <StackPanel>
                                            <materialDesign:PackIcon Kind="Stop" Width="20" Height="20" Foreground="#F44336" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Stop" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource RibbonBtnLarge}" Command="{Binding ResetCommand}" ToolTip="Reset">
                                        <StackPanel>
                                            <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" Foreground="#FF9800" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Reset" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="Action" Foreground="#858585" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Tools Group -->
                        <Border BorderBrush="#3E3E42" BorderThickness="0,0,1,0" Padding="8,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="68">
                                    <Button Style="{StaticResource RibbonBtnLarge}" Command="{Binding ShowHeatmapCommand}" ToolTip="Show Heatmap">
                                        <StackPanel>
                                            <materialDesign:PackIcon Kind="ViewGrid" Width="20" Height="20" Foreground="#4EC9B0" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Heatmap" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource RibbonBtnLarge}" Command="{Binding SaveMeanCommand}" IsEnabled="{Binding CanSaveMean}" ToolTip="Save Mean Values">
                                        <StackPanel>
                                            <materialDesign:PackIcon Kind="ContentSave" Width="20" Height="20" Foreground="#5B9BD5" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Save" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="Tools" Foreground="#858585" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Status Display -->
                        <Border BorderBrush="#3E3E42" BorderThickness="0,0,1,0" Padding="12,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="STATUS" Foreground="#858585" FontSize="10"/>
                                <TextBlock Text="{Binding StatusMessage}" Foreground="#4EC9B0" FontSize="11" FontWeight="SemiBold" 
                                           MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                                <ProgressBar Value="{Binding ProgressValue}" Maximum="100" Height="4" Width="120" 
                                             Margin="0,6,0,0" Background="#3E3E42" Foreground="#007ACC"/>
                            </StackPanel>
                        </Border>

                        <!-- DSSD Selection -->
                        <Border Padding="12,0">
                            <StackPanel>
                                <StackPanel VerticalAlignment="Center" Height="68">
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="Layer:" Foreground="#CCCCCC" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox SelectedIndex="{Binding SelectedLayerIndex}" Width="80" Style="{StaticResource RibbonCombo}">
                                            <ComboBoxItem Content="L1"/>
                                            <ComboBoxItem Content="L2"/>
                                            <ComboBoxItem Content="L6"/>
                                            <ComboBoxItem Content="L7"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="Strip:" Foreground="#CCCCCC" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox SelectedIndex="{Binding SelectedDirectionIndex}" Width="80" Style="{StaticResource RibbonCombo}">
                                            <ComboBoxItem Content="X (1-8)"/>
                                            <ComboBoxItem Content="Z (9-16)"/>
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="DSSD" Foreground="#858585" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- View Group (X-Axis) -->
                        <Border Padding="12,0">
                            <StackPanel>
                                <StackPanel VerticalAlignment="Center" Height="68">
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="X-Axis:" Foreground="#CCCCCC" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox SelectedIndex="{Binding SelectedXAxisIndex}" Width="120" Style="{StaticResource RibbonCombo}">
                                            <ComboBoxItem Content="ADC Channel (0-16383)"/>
                                            <ComboBoxItem Content="Voltage (mV)"/>
                                            <ComboBoxItem Content="Energy (MeV)"/>
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="View" Foreground="#858585" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>


                    </StackPanel>

                    <!-- OBSERVATION Toolbar -->
                    <StackPanel x:Name="ToolbarObservation" Orientation="Horizontal" Margin="8,4" Visibility="Collapsed">
                        <!-- File Group -->
                        <Border BorderBrush="#3E3E42" BorderThickness="0,0,1,0" Padding="8,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="68">
                                    <Button x:Name="ObsBtnSelectFiles" Style="{StaticResource RibbonBtnLarge}" Click="ObsBtnSelectFiles_Click" ToolTip="Select Files">
                                        <StackPanel>
                                            <materialDesign:PackIcon Kind="FileMultiple" Width="20" Height="20" Foreground="#5B9BD5" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Select" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="ObsBtnExport" Style="{StaticResource RibbonBtnLarge}" Click="ObsBtnExport_Click" ToolTip="Export to Excel">
                                        <StackPanel>
                                            <materialDesign:PackIcon Kind="Export" Width="20" Height="20" Foreground="#4EC9B0" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Export" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <StackPanel VerticalAlignment="Center" Margin="4,0,0,0">
                                        <TextBlock Text="Output:" Foreground="#858585" FontSize="10"/>
                                        <TextBox x:Name="ObsTxtOutputFileName" Style="{StaticResource RibbonInput}" Width="100" Text="output"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="File" Foreground="#858585" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Processing Group -->
                        <Border BorderBrush="#3E3E42" BorderThickness="0,0,1,0" Padding="8,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="68">
                                    <Button x:Name="ObsBtnProcessData" Style="{StaticResource RibbonBtnLarge}" Click="ObsBtnProcessData_Click" ToolTip="Process Data">
                                        <StackPanel>
                                            <materialDesign:PackIcon Kind="Play" Width="20" Height="20" Foreground="#4CAF50" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Process" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="ObsBtnReadData" Style="{StaticResource RibbonBtnLarge}" Click="ObsBtnReadData_Click" ToolTip="Read Data">
                                        <StackPanel>
                                            <materialDesign:PackIcon Kind="DatabaseImport" Width="20" Height="20" Foreground="#FFB347" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Read" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="ObsBtnReset" Style="{StaticResource RibbonBtnLarge}" Click="ObsBtnReset_Click" ToolTip="Reset">
                                        <StackPanel>
                                            <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" Foreground="#F44336" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Reset" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="Processing" Foreground="#858585" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- DSSD View Group -->
                        <Border BorderBrush="#3E3E42" BorderThickness="0,0,1,0" Padding="12,0">
                            <StackPanel>
                                <StackPanel VerticalAlignment="Center" Height="68">
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="Layer:" Foreground="#CCCCCC" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <ComboBox x:Name="ObsCmbDSSDLayer" Width="60" Style="{StaticResource RibbonCombo}"
                                                  SelectionChanged="ObsCmbDSSDLayer_SelectionChanged">
                                            <ComboBoxItem Content="L1" IsSelected="True"/>
                                            <ComboBoxItem Content="L2"/>
                                            <ComboBoxItem Content="L6"/>
                                            <ComboBoxItem Content="L7"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="X:" Foreground="#858585" FontSize="10" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                        <TextBox x:Name="ObsTxtDSSDXMin" Text="0" Style="{StaticResource RibbonInput}" Width="45" TextChanged="ObsTxtDSSDAxisChanged"/>
                                        <TextBlock Text="-" Foreground="#858585" FontSize="10" VerticalAlignment="Center" Margin="2,0"/>
                                        <TextBox x:Name="ObsTxtDSSDXMax" Text="16384" Style="{StaticResource RibbonInput}" Width="50" TextChanged="ObsTxtDSSDAxisChanged"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="DSSD View" Foreground="#858585" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Fitting Group -->
                        <Border BorderBrush="#3E3E42" BorderThickness="0,0,1,0" Padding="12,0">
                            <StackPanel>
                                <StackPanel VerticalAlignment="Center" Height="68">
                                    <CheckBox x:Name="ObsChkDSSDFit" Margin="0,8,0,0" Checked="ObsChkDSSDFit_Changed" Unchecked="ObsChkDSSDFit_Changed">
                                        <TextBlock Text="Curve Fit" Foreground="#CCCCCC" FontSize="11"/>
                                    </CheckBox>
                                    <ComboBox x:Name="ObsCmbDSSDFitMethod" Width="90" Style="{StaticResource RibbonCombo}" Margin="0,6,0,0">
                                        <ComboBoxItem Content="Gaussian" IsSelected="True"/>
                                        <ComboBoxItem Content="Lorentzian"/>
                                    </ComboBox>
                                </StackPanel>
                                <TextBlock Text="Fitting" Foreground="#858585" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Actions Group -->
                        <Border BorderBrush="#3E3E42" BorderThickness="0,0,1,0" Padding="8,0">
                            <StackPanel>
