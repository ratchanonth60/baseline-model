<Window x:Class="BaselineMode.WPF.Views.UnifiedMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:BaselineMode.WPF.Views.models"
        xmlns:scott="clr-namespace:ScottPlot;assembly=ScottPlot.WPF"
        mc:Ignorable="d"
        Title="DSSD Analysis Suite - v1.4.0"
        Height="950" Width="1700"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource MaterialDesignWindow}"
        Background="{DynamicResource MaterialDesign.Brush.Background}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Colors.xaml"/>
                <ResourceDictionary Source="Resources/Styles.xaml"/>
                <ResourceDictionary Source="Resources/Buttons.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Card Style -->
            <Style x:Key="ObsCardStyle" TargetType="materialDesign:Card">
                <Setter Property="Padding" Value="16"/>
                <Setter Property="Margin" Value="8"/>
                <Setter Property="UniformCornerRadius" Value="8"/>
            </Style>
            
            <Style x:Key="ObsHeaderTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
            </Style>
            
            <Style x:Key="ObsStatLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Foreground" Value="#B0BEC5"/>
                <Setter Property="Margin" Value="8,4,4,4"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            
            <Style x:Key="ObsStatValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Margin" Value="0,4,12,4"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            
            <!-- Ribbon Tab Style -->
            <Style x:Key="RibbonTabItem" TargetType="TabItem">
                <Setter Property="Padding" Value="16,8"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="border" Padding="{TemplateBinding Padding}" 
                                    Background="Transparent" BorderThickness="0,0,0,3" BorderBrush="Transparent"
                                    Cursor="Hand">
                                <ContentPresenter x:Name="contentPresenter" 
                                                  ContentSource="Header" 
                                                  HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary.Light}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource MaterialDesign.Brush.Background}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            
            <!-- Ribbon Group Box Style -->
            <Style x:Key="RibbonGroupStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}"/>
                <Setter Property="BorderThickness" Value="0,0,1,0"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="Margin" Value="0"/>
            </Style>
            
            <!-- Ribbon Button Style -->
            <Style x:Key="RibbonButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                <Setter Property="Height" Value="Auto"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="Margin" Value="2"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            
            <Style x:Key="RibbonButtonLargeStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                <Setter Property="Height" Value="64"/>
                <Setter Property="Width" Value="64"/>
                <Setter Property="Padding" Value="4"/>
                <Setter Property="Margin" Value="4"/>
            </Style>
            
            <Style x:Key="RibbonGroupLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground.Light}"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,4,0,0"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <materialDesign:ColorZone Mode="PrimaryDark" Grid.Row="0" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ChartDonut" Width="28" Height="28" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="DSSD Analysis Suite" FontSize="18" FontWeight="Medium" VerticalAlignment="Center"/>
                    <TextBlock Text="v1.4.0" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.7"/>
                </StackPanel>
                
                <TextBlock Grid.Column="2" Text="{Binding CurrentDateTime, StringFormat='yyyy-MM-dd HH:mm:ss'}" 
                           FontSize="12" VerticalAlignment="Center" Opacity="0.9"/>
            </Grid>
        </materialDesign:ColorZone>

        <!-- Ribbon Tabs -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}" 
                BorderThickness="0,0,0,1" Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
            <TabControl x:Name="RibbonTabControl" Style="{StaticResource MaterialDesignTabControl}" 
                        SelectionChanged="RibbonTabControl_SelectionChanged">
                <!-- Home Tab -->
                <TabItem Header="🏠 Home" Style="{StaticResource RibbonTabItem}">
                    <Border Padding="8,4" Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
                        <StackPanel Orientation="Horizontal">
                            <!-- Mode Selection Group -->
                            <Border Style="{StaticResource RibbonGroupStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BtnSwitchToBaseline" Style="{StaticResource RibbonButtonLargeStyle}" 
                                                Click="BtnSwitchToBaseline_Click" ToolTip="Baseline Mode">
                                            <StackPanel>
                                                <materialDesign:PackIcon Kind="ChartLine" Width="28" Height="28" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Baseline" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnSwitchToObservation" Style="{StaticResource RibbonButtonLargeStyle}" 
                                                Click="BtnSwitchToObservation_Click" ToolTip="Observation Mode">
                                            <StackPanel>
                                                <materialDesign:PackIcon Kind="Microscope" Width="28" Height="28" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Observe" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Text="Mode" Style="{StaticResource RibbonGroupLabelStyle}"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Quick Actions Group -->
                            <Border Style="{StaticResource RibbonGroupStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource RibbonButtonLargeStyle}" Command="{Binding SelectFilesCommand}" 
                                                ToolTip="Select Input Files">
                                            <StackPanel>
                                                <materialDesign:PackIcon Kind="FolderOpen" Width="28" Height="28" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Open" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource RibbonButtonLargeStyle}" Command="{Binding ProcessDataCommand}" 
                                                ToolTip="Start Processing">
                                            <StackPanel>
                                                <materialDesign:PackIcon Kind="Play" Width="28" Height="28" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Start" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <StackPanel VerticalAlignment="Center" Margin="4,0">
                                            <Button Style="{StaticResource RibbonButtonStyle}" Command="{Binding StopCommand}" 
                                                    Content="⏹ Stop" ToolTip="Stop Processing"/>
                                            <Button Style="{StaticResource RibbonButtonStyle}" Command="{Binding ResetCommand}" 
                                                    Content="🔄 Reset" ToolTip="Reset All"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="Quick Actions" Style="{StaticResource RibbonGroupLabelStyle}"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Current Mode Info -->
                            <Border Style="{StaticResource RibbonGroupStyle}">
                                <StackPanel VerticalAlignment="Center" MinWidth="150">
                                    <TextBlock x:Name="TxtCurrentMode" Text="📊 Baseline Mode" FontSize="14" FontWeight="Bold" 
                                               Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                    <TextBlock x:Name="TxtModeDescription" Text="Charged Particle Detector Analysis" 
                                               FontSize="11" Opacity="0.7" Margin="0,4,0,0"/>
                                    <TextBlock Text="Current Mode" Style="{StaticResource RibbonGroupLabelStyle}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </TabItem>

                <!-- Data Tab -->
                <TabItem Header="📁 Data" Style="{StaticResource RibbonTabItem}">
                    <Border Padding="8,4" Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
                        <StackPanel Orientation="Horizontal">
                            <!-- File Group -->
                            <Border Style="{StaticResource RibbonGroupStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource RibbonButtonLargeStyle}" Command="{Binding SelectFilesCommand}">
                                            <StackPanel>
                                                <materialDesign:PackIcon Kind="FileMultiple" Width="28" Height="28" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Select Files" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <StackPanel VerticalAlignment="Center" Margin="4,0">
                                            <Button Style="{StaticResource RibbonButtonStyle}" Command="{Binding BrowseOutputDirectoryCommand}" 
                                                    Content="📂 Output Folder"/>
                                            <Button Style="{StaticResource RibbonButtonStyle}" Command="{Binding CheckHeaderCommand}" 
                                                    Content="📋 Check Header"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="File" Style="{StaticResource RibbonGroupLabelStyle}"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Processing Group -->
                            <Border Style="{StaticResource RibbonGroupStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource RibbonButtonLargeStyle}" Command="{Binding PreProcessDataCommand}">
                                            <StackPanel>
                                                <materialDesign:PackIcon Kind="DatabaseRefresh" Width="28" Height="28" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Pre-Process" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource RibbonButtonLargeStyle}" Command="{Binding ProcessDataCommand}">
                                            <StackPanel>
                                                <materialDesign:PackIcon Kind="Cogs" Width="28" Height="28" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Process" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Text="Processing" Style="{StaticResource RibbonGroupLabelStyle}"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Output Group -->
                            <Border Style="{StaticResource RibbonGroupStyle}">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Output Filename:" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding OutputFileName, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                                             Width="180" materialDesign:HintAssist.Hint="filename"/>
                                    <TextBlock Text="Output" Style="{StaticResource RibbonGroupLabelStyle}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </TabItem>

                <!-- Analysis Tab -->
                <TabItem Header="📊 Analysis" Style="{StaticResource RibbonTabItem}">
                    <Border Padding="8,4" Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
                        <StackPanel Orientation="Horizontal">
                            <!-- DSSD Settings Group -->
                            <Border Style="{StaticResource RibbonGroupStyle}">
                                <StackPanel VerticalAlignment="Center">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Layer:" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                        <ComboBox Grid.Column="1" SelectedIndex="{Binding SelectedLayerIndex}" Margin="0,0,0,4"
                                                  Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                            <ComboBoxItem Content="DSSD L1"/><ComboBoxItem Content="DSSD L2"/>
                                            <ComboBoxItem Content="DSSD L6"/><ComboBoxItem Content="DSSD L7"/>
                                        </ComboBox>
                                        <TextBlock Text="Strip:" Grid.Row="1" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox Grid.Row="1" Grid.Column="1" SelectedIndex="{Binding SelectedDirectionIndex}"
                                                  Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                            <ComboBoxItem Content="X (1-8)"/><ComboBoxItem Content="Z (9-16)"/>
                                        </ComboBox>
                                    </Grid>
                                    <TextBlock Text="DSSD" Style="{StaticResource RibbonGroupLabelStyle}"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Mode Settings Group -->
                            <Border Style="{StaticResource RibbonGroupStyle}">
                                <StackPanel VerticalAlignment="Center">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="130"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Mode:" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                        <ComboBox Grid.Column="1" SelectedIndex="{Binding SelectedMode}" Margin="0,0,0,4"
                                                  Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                            <ComboBoxItem Content="Cut off baseline"/><ComboBoxItem Content="Baseline setting"/>
                                        </ComboBox>
                                        <TextBlock Text="Subtract:" Grid.Row="1" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox Grid.Row="1" Grid.Column="1" SelectedIndex="{Binding SelectedBaselineMode}"
                                                  Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                            <ComboBoxItem Content="Before"/><ComboBoxItem Content="After"/>
                                            <ComboBoxItem Content="Before (log)"/><ComboBoxItem Content="After (log)"/>
                                        </ComboBox>
                                    </Grid>
                                    <TextBlock Text="Baseline" Style="{StaticResource RibbonGroupLabelStyle}"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Fitting Group -->
                            <Border Style="{StaticResource RibbonGroupStyle}">
                                <StackPanel VerticalAlignment="Center">
                                    <CheckBox IsChecked="{Binding UseThresholding}" Content="Adaptive Threshold" 
                                              Style="{StaticResource MaterialDesignCheckBox}" Margin="0,0,0,4"/>
                                    <CheckBox IsChecked="{Binding UseGaussianFit}" Content="Curve Fitting" 
                                              Style="{StaticResource MaterialDesignCheckBox}" Margin="0,0,0,4"/>
                                    <ComboBox SelectedIndex="{Binding SelectedFitMethod}" IsEnabled="{Binding UseGaussianFit}"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}" Width="110">
                                        <ComboBoxItem Content="Gaussian"/><ComboBoxItem Content="Hyper-EMG"/>
                                    </ComboBox>
                                    <TextBlock Text="Fitting" Style="{StaticResource RibbonGroupLabelStyle}"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- View Group -->
                            <Border Style="{StaticResource RibbonGroupStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource RibbonButtonLargeStyle}" Command="{Binding ShowHeatmapCommand}">
                                            <StackPanel>
                                                <materialDesign:PackIcon Kind="Grid" Width="28" Height="28" HorizontalAlignment="Center"/>
                                                <TextBlock Text="2D Heatmap" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource RibbonButtonLargeStyle}" Command="{Binding SaveMeanCommand}" 
                                                IsEnabled="{Binding CanSaveMean}">
                                            <StackPanel>
                                                <materialDesign:PackIcon Kind="ContentSave" Width="28" Height="28" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Save Mean" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Text="View" Style="{StaticResource RibbonGroupLabelStyle}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </TabItem>

                <!-- Config Tab -->
                <TabItem Header="⚙️ Config" Style="{StaticResource RibbonTabItem}">
                    <Border Padding="8,4" Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
                        <StackPanel Orientation="Horizontal">
                            <!-- Parameters Group -->
                            <Border Style="{StaticResource RibbonGroupStyle}">
                                <StackPanel VerticalAlignment="Center">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Delay (μs):" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                        <TextBox Grid.Column="1" Text="{Binding DelayTimeMs, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,4"/>
                                        <TextBlock Text="Threshold:" Grid.Row="1" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ThresholdValue, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                    </Grid>
                                    <TextBlock Text="Parameters" Style="{StaticResource RibbonGroupLabelStyle}"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- X-Axis Group -->
                            <Border Style="{StaticResource RibbonGroupStyle}">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="X-Axis Unit:" FontSize="11" Margin="0,0,0,4"/>
                                    <ComboBox SelectedIndex="{Binding SelectedXAxisIndex}" Width="120"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                        <ComboBoxItem Content="ADC Channel"/>
                                        <ComboBoxItem Content="Voltage (mV)"/>
                                        <ComboBoxItem Content="Energy (MeV)"/>
                                    </ComboBox>
                                    <TextBlock Text="X-Axis" Style="{StaticResource RibbonGroupLabelStyle}"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Settings Group -->
                            <Border Style="{StaticResource RibbonGroupStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BtnSettings" Style="{StaticResource RibbonButtonLargeStyle}" 
                                                Click="BtnSettings_Click">
                                            <StackPanel>
                                                <materialDesign:PackIcon Kind="Cog" Width="28" Height="28" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Settings" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource RibbonButtonLargeStyle}" ToolTip="About">
                                            <StackPanel>
                                                <materialDesign:PackIcon Kind="InformationOutline" Width="28" Height="28" HorizontalAlignment="Center"/>
                                                <TextBlock Text="About" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Text="Application" Style="{StaticResource RibbonGroupLabelStyle}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </TabItem>

                <!-- Observation Tab -->
                <TabItem Header="🔬 Observation" Style="{StaticResource RibbonTabItem}">
                    <Border Padding="8,4" Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
                        <StackPanel Orientation="Horizontal">
                            <!-- Obs File Group -->
                            <Border Style="{StaticResource RibbonGroupStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="ObsBtnSelectFiles" Style="{StaticResource RibbonButtonLargeStyle}" 
                                                Click="ObsBtnSelectFiles_Click">
                                            <StackPanel>
                                                <materialDesign:PackIcon Kind="FileMultiple" Width="28" Height="28" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Select Files" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <StackPanel VerticalAlignment="Center" Margin="4,0">
                                            <Button x:Name="ObsBtnHeaderCheck" Style="{StaticResource RibbonButtonStyle}" 
                                                    Content="📋 Check Header" Click="ObsBtnHeaderCheck_Click"/>
                                            <Button x:Name="ObsBtnOpenResults" Style="{StaticResource RibbonButtonStyle}" 
                                                    Content="📂 Open Results" Click="ObsBtnOpenResults_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="File" Style="{StaticResource RibbonGroupLabelStyle}"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Obs Processing Group -->
                            <Border Style="{StaticResource RibbonGroupStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="ObsBtnProcessData" Style="{StaticResource RibbonButtonLargeStyle}" 
                                                Click="ObsBtnProcessData_Click">
                                            <StackPanel>
                                                <materialDesign:PackIcon Kind="Cogs" Width="28" Height="28" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Process" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="ObsBtnReadData" Style="{StaticResource RibbonButtonLargeStyle}" 
                                                Click="ObsBtnReadData_Click">
                                            <StackPanel>
                                                <materialDesign:PackIcon Kind="DatabaseImport" Width="28" Height="28" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Read Data" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="ObsBtnReset" Style="{StaticResource RibbonButtonLargeStyle}" 
                                                Click="ObsBtnReset_Click">
                                            <StackPanel>
                                                <materialDesign:PackIcon Kind="Refresh" Width="28" Height="28" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Reset" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Text="Processing" Style="{StaticResource RibbonGroupLabelStyle}"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Obs DSSD Group -->
                            <Border Style="{StaticResource RibbonGroupStyle}">
                                <StackPanel VerticalAlignment="Center">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Layer:" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                        <ComboBox x:Name="ObsCmbDSSDLayer" Grid.Column="1" Margin="0,0,0,4"
                                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                  SelectionChanged="ObsCmbDSSDLayer_SelectionChanged">
                                            <ComboBoxItem Content="Layer 1" IsSelected="True"/>
                                            <ComboBoxItem Content="Layer 2"/>
                                            <ComboBoxItem Content="Layer 6"/>
                                            <ComboBoxItem Content="Layer 7"/>
                                        </ComboBox>
                                        <CheckBox x:Name="ObsChkDSSDFit" Grid.Row="1" Grid.ColumnSpan="2" Content="Curve Fit" 
                                                  Checked="ObsChkDSSDFit_Changed" Unchecked="ObsChkDSSDFit_Changed"/>
                                    </Grid>
                                    <TextBlock Text="DSSD Settings" Style="{StaticResource RibbonGroupLabelStyle}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </TabItem>
            </TabControl>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="2">
            <!-- Baseline Mode Content -->
            <Grid x:Name="BaselineModeContent" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Panel - Status & Info -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="8">
                    <StackPanel>
                        <!-- Progress Card -->
                        <materialDesign:Card Style="{StaticResource ObsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="📊 Progress" Style="{StaticResource ObsHeaderTextStyle}"/>
                                <ProgressBar Value="{Binding ProgressValue}" Height="8" Maximum="100" Margin="0,0,0,8"
                                             Style="{StaticResource MaterialDesignLinearProgressBar}"/>
                                <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="Medium" 
                                           Foreground="{DynamicResource MaterialDesign.Brush.Primary}" 
                                           HorizontalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- File Info Card -->
                        <materialDesign:Card Style="{StaticResource ObsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="📁 Files" Style="{StaticResource ObsHeaderTextStyle}"/>
                                <TextBlock Text="{Binding InputFilesInfo}" FontSize="11" Foreground="Gray" 
                                           TextWrapping="Wrap" MaxHeight="100"/>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Statistics Card -->
                        <materialDesign:Card Style="{StaticResource ObsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="📈 Statistics" Style="{StaticResource ObsHeaderTextStyle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Start:" Grid.Row="0" Style="{StaticResource ObsStatLabelStyle}" Margin="0,0,8,4"/>
                                    <TextBlock Text="{Binding StartTimeStr}" Grid.Row="0" Grid.Column="1" Style="{StaticResource ObsStatValueStyle}" HorizontalAlignment="Right"/>
                                    <TextBlock Text="Stop:" Grid.Row="1" Style="{StaticResource ObsStatLabelStyle}" Margin="0,0,8,4"/>
                                    <TextBlock Text="{Binding StopTimeStr}" Grid.Row="1" Grid.Column="1" Style="{StaticResource ObsStatValueStyle}" HorizontalAlignment="Right"/>
                                    <TextBlock Text="Duration:" Grid.Row="2" Style="{StaticResource ObsStatLabelStyle}" Margin="0,0,8,4"/>
                                    <TextBlock Text="{Binding DurationStr}" Grid.Row="2" Grid.Column="1" Style="{StaticResource ObsStatValueStyle}" HorizontalAlignment="Right"/>
                                    <TextBlock Text="Data Count:" Grid.Row="3" Style="{StaticResource ObsStatLabelStyle}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding DataCountsStr}" Grid.Row="3" Grid.Column="1" Style="{StaticResource ObsStatValueStyle}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </materialDesign:Card>
                    </StackPanel>
                </ScrollViewer>

                <!-- Right Panel - Charts -->
                <materialDesign:Card Grid.Column="1" Style="{StaticResource ObsCardStyle}" Padding="0" Margin="0,8,8,8">
                    <TabControl Style="{StaticResource MaterialDesignTabControl}">
                        <TabItem Header="📈 X-Direction (Ch 1-8)">
                            <ItemsControl ItemsSource="{Binding ChannelsX}" Margin="8">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Rows="2" Columns="4"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <materialDesign:Card Margin="4" UniformCornerRadius="6">
                                            <materialDesign:Card.InputBindings>
                                                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding DataContext.ShowChannelDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                            </materialDesign:Card.InputBindings>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" Margin="6,4" FontSize="10"/>
                                                <scott:WpfPlot Grid.Row="1" x:Name="WpfPlot" Loaded="WpfPlot_Loaded" Tag="{Binding}" Margin="2"/>
                                                <TextBlock Text="{Binding StatsText}" Grid.Row="2" FontSize="9" Margin="6,2,6,4" Foreground="Gray"/>
                                            </Grid>
                                        </materialDesign:Card>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </TabItem>
                        <TabItem Header="📈 Z-Direction (Ch 9-16)">
                            <ItemsControl ItemsSource="{Binding ChannelsZ}" Margin="8">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Rows="2" Columns="4"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <materialDesign:Card Margin="4" UniformCornerRadius="6">
                                            <materialDesign:Card.InputBindings>
                                                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding DataContext.ShowChannelDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                            </materialDesign:Card.InputBindings>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" Margin="6,4" FontSize="10"/>
                                                <scott:WpfPlot Grid.Row="1" x:Name="WpfPlot" Loaded="WpfPlot_Loaded" Tag="{Binding}" Margin="2"/>
                                                <TextBlock Text="{Binding StatsText}" Grid.Row="2" FontSize="9" Margin="6,2,6,4" Foreground="Gray"/>
                                            </Grid>
                                        </materialDesign:Card>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </TabItem>
                        <TabItem Header="📋 Data View">
                            <Grid Margin="12">
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <DataGrid ItemsSource="{Binding DisplayDataTable}" AutoGenerateColumns="True" HeadersVisibility="Column"
                                          Style="{StaticResource MaterialDesignDataGrid}"/>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                    <Button Content="◀ Prev" Command="{Binding PreviousPageCommand}" 
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Width="80" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding PageInfoText}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <Button Content="Next ▶" Command="{Binding NextPageCommand}" 
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Width="80" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </TabItem>
                        <TabItem Header="📄 Header Info">
                            <TextBox Text="{Binding HeaderInfoText}" IsReadOnly="True" FontFamily="Consolas" FontSize="12" 
                                     Padding="12" BorderThickness="0" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     Style="{StaticResource MaterialDesignTextBox}"/>
                        </TabItem>
                    </TabControl>
                </materialDesign:Card>
            </Grid>

            <!-- Observation Mode Content -->
            <Grid x:Name="ObservationModeContent" Visibility="Collapsed">
                <TabControl Style="{StaticResource MaterialDesignTabControl}" Margin="8">
                    <!-- Data Processing Tab -->
                    <TabItem Header="📁 Data Processing">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Margin="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- File Status Card -->
                                <materialDesign:Card Style="{StaticResource ObsCardStyle}" Grid.Row="0" Grid.Column="0">
                                    <StackPanel>
                                        <TextBlock Text="📁 File Status" Style="{StaticResource ObsHeaderTextStyle}"/>
                                        <TextBlock x:Name="ObsTxtFileStatus" Text="No files selected" 
                                                   TextWrapping="Wrap" Foreground="Gray"/>
                                    </StackPanel>
                                </materialDesign:Card>

                                <!-- Output Settings Card -->
                                <materialDesign:Card Style="{StaticResource ObsCardStyle}" Grid.Row="0" Grid.Column="1">
                                    <StackPanel>
                                        <TextBlock Text="💾 Output Settings" Style="{StaticResource ObsHeaderTextStyle}"/>
                                        <TextBox x:Name="ObsTxtOutputFileName" 
                                                 materialDesign:HintAssist.Hint="Output filename (without extension)"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                    </StackPanel>
                                </materialDesign:Card>

                                <!-- Progress Card -->
                                <materialDesign:Card Style="{StaticResource ObsCardStyle}" Grid.Row="1" Grid.Column="0">
                                    <StackPanel>
                                        <TextBlock Text="⏱️ Progress" Style="{StaticResource ObsHeaderTextStyle}"/>
                                        <ProgressBar x:Name="ObsProgressBar" Height="8" Margin="0,0,0,8"/>
                                        <TextBlock x:Name="ObsTxtProgress" Text="Ready" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="ObsTxtHeaderStatus" Text="" HorizontalAlignment="Center" 
                                                   Foreground="LightGreen" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </materialDesign:Card>

                                <!-- Time Info Card -->
                                <materialDesign:Card Style="{StaticResource ObsCardStyle}" Grid.Row="1" Grid.Column="1">
                                    <StackPanel>
                                        <TextBlock Text="📊 Statistics" Style="{StaticResource ObsHeaderTextStyle}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Data Count:" Style="{StaticResource ObsStatLabelStyle}" Grid.Row="0"/>
                                            <TextBlock x:Name="ObsTxtDataCount" Text="-" Style="{StaticResource ObsStatValueStyle}" Grid.Row="0" Grid.Column="1"/>
                                            <TextBlock Text="Particles:" Style="{StaticResource ObsStatLabelStyle}" Grid.Row="1"/>
                                            <TextBlock x:Name="ObsTxtParticleCount" Text="-" Style="{StaticResource ObsStatValueStyle}" Grid.Row="1" Grid.Column="1"/>
                                            <TextBlock Text="Start Time:" Style="{StaticResource ObsStatLabelStyle}" Grid.Row="2"/>
                                            <TextBlock x:Name="ObsTxtStartTime" Text="-" Style="{StaticResource ObsStatValueStyle}" Grid.Row="2" Grid.Column="1"/>
                                            <TextBlock Text="Stop Time:" Style="{StaticResource ObsStatLabelStyle}" Grid.Row="3"/>
                                            <TextBlock x:Name="ObsTxtStopTime" Text="-" Style="{StaticResource ObsStatValueStyle}" Grid.Row="3" Grid.Column="1"/>
                                        </Grid>
                                    </StackPanel>
                                </materialDesign:Card>

                                <!-- Header Data -->
                                <materialDesign:Card Style="{StaticResource ObsCardStyle}" Grid.Row="2" Grid.ColumnSpan="2">
                                    <StackPanel>
                                        <TextBlock Text="📄 Header Information" Style="{StaticResource ObsHeaderTextStyle}"/>
                                        <TextBox x:Name="ObsTxtHeaderData" 
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 TextWrapping="Wrap" AcceptsReturn="True"
                                                 IsReadOnly="True" MinHeight="200"
                                                 VerticalScrollBarVisibility="Auto"
                                                 FontFamily="Consolas" FontSize="12"/>
                                    </StackPanel>
                                </materialDesign:Card>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <!-- DSSD Analysis Tab -->
                    <TabItem Header="📊 DSSD Analysis">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Axis Controls -->
                            <materialDesign:Card Style="{StaticResource ObsCardStyle}" Grid.Row="0" Padding="12" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="X Range:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Medium"/>
                                    <TextBox x:Name="ObsTxtDSSDXMin" Text="0" Width="60" Margin="0,0,8,0"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             TextChanged="ObsTxtDSSDAxisChanged"/>
                                    <TextBlock Text="to" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="ObsTxtDSSDXMax" Text="16384" Width="60" Margin="0,0,16,0"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             TextChanged="ObsTxtDSSDAxisChanged"/>
                                    
                                    <ComboBox x:Name="ObsCmbDSSDFitMethod" Width="100" Margin="0,0,8,0"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                        <ComboBoxItem Content="Gaussian" IsSelected="True"/>
                                        <ComboBoxItem Content="Lorentzian"/>
                                    </ComboBox>
                                </StackPanel>
                            </materialDesign:Card>
                            
                            <!-- DSSD Plots -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <materialDesign:Card Style="{StaticResource ObsCardStyle}" Grid.Column="0" Margin="4">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Pulse Height X" Style="{StaticResource ObsHeaderTextStyle}"/>
                                        <scott:WpfPlot x:Name="ObsPlotDSSDX" Grid.Row="1"/>
                                        <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                                            <TextBlock Text="Peak:" Style="{StaticResource ObsStatLabelStyle}"/>
                                            <TextBlock x:Name="ObsTxtDSSDXPeak" Text="-" Style="{StaticResource ObsStatValueStyle}" Foreground="#FF5252"/>
                                            <TextBlock Text="Mean:" Style="{StaticResource ObsStatLabelStyle}"/>
                                            <TextBlock x:Name="ObsTxtDSSDXMean" Text="-" Style="{StaticResource ObsStatValueStyle}" Foreground="#69F0AE"/>
                                            <TextBlock Text="FWHM:" Style="{StaticResource ObsStatLabelStyle}"/>
                                            <TextBlock x:Name="ObsTxtDSSDXFWHM" Text="-" Style="{StaticResource ObsStatValueStyle}" Foreground="#40C4FF"/>
                                        </WrapPanel>
                                    </Grid>
                                </materialDesign:Card>
                                
                                <materialDesign:Card Style="{StaticResource ObsCardStyle}" Grid.Column="1" Margin="4">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Pulse Height Y" Style="{StaticResource ObsHeaderTextStyle}"/>
                                        <scott:WpfPlot x:Name="ObsPlotDSSDY" Grid.Row="1"/>
                                        <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                                            <TextBlock Text="Peak:" Style="{StaticResource ObsStatLabelStyle}"/>
                                            <TextBlock x:Name="ObsTxtDSSDYPeak" Text="-" Style="{StaticResource ObsStatValueStyle}" Foreground="#FF5252"/>
                                            <TextBlock Text="Mean:" Style="{StaticResource ObsStatLabelStyle}"/>
                                            <TextBlock x:Name="ObsTxtDSSDYMean" Text="-" Style="{StaticResource ObsStatValueStyle}" Foreground="#69F0AE"/>
                                            <TextBlock Text="FWHM:" Style="{StaticResource ObsStatLabelStyle}"/>
                                            <TextBlock x:Name="ObsTxtDSSDYFWHM" Text="-" Style="{StaticResource ObsStatValueStyle}" Foreground="#40C4FF"/>
                                        </WrapPanel>
                                    </Grid>
                                </materialDesign:Card>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- Settings Content -->
            <Grid x:Name="SettingsContent" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="32" MaxWidth="800" HorizontalAlignment="Left">
                        <TextBlock Text="⚙️ Application Settings" FontSize="24" FontWeight="Bold" Margin="0,0,0,24"/>
                        
                        <materialDesign:Card Style="{StaticResource ObsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="🎨 Appearance" FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>
                                <CheckBox x:Name="ChkDarkMode" Content="Dark Mode" Margin="0,0,0,12"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Theme Color:" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <ComboBox x:Name="CmbThemeColor" Width="150">
                                        <ComboBoxItem Content="Blue" IsSelected="True"/>
                                        <ComboBoxItem Content="Indigo"/>
                                        <ComboBoxItem Content="Teal"/>
                                        <ComboBoxItem Content="Green"/>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </materialDesign:Card>
                        
                        <materialDesign:Card Style="{StaticResource ObsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="📁 Default Paths" FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>
                                <TextBlock Text="Default Output Directory" FontWeight="Medium" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtDefaultOutputPath" IsReadOnly="True" 
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                    <Button Grid.Column="1" Content="Browse" 
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Margin="8,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </materialDesign:Card>
                        
                        <materialDesign:Card Style="{StaticResource ObsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="ℹ️ About" FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>
                                <TextBlock Text="DSSD Analysis Suite" FontWeight="Bold" FontSize="18"/>
                                <TextBlock Text="Version 1.4.0" Margin="0,4,0,0"/>
                                <TextBlock Text="Unified Baseline and Observation Mode Analysis" Margin="0,8,0,0" Foreground="Gray"/>
                                <TextBlock Text="© 2024 - Particle Physics Lab" Margin="0,4,0,0" Foreground="Gray"/>
                            </StackPanel>
                        </materialDesign:Card>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <materialDesign:ColorZone Mode="PrimaryLight" Grid.Row="3" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock x:Name="TxtStatusBar" Text="{Binding StatusMessage}" VerticalAlignment="Center" FontSize="12"/>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0">
                    <TextBlock Text="Progress:" VerticalAlignment="Center" FontSize="11" Margin="0,0,8,0"/>
                    <ProgressBar Value="{Binding ProgressValue}" Width="100" Height="6" Maximum="100"
                                 Style="{StaticResource MaterialDesignLinearProgressBar}"/>
                    <TextBlock Text="{Binding ProgressValue, StringFormat={}{0:F0}%}" VerticalAlignment="Center" 
                               FontSize="11" Margin="8,0,0,0"/>
                </StackPanel>
                
                <TextBlock Grid.Column="2" Text="{Binding DataCountsStr, StringFormat='Data: {0}'}" 
                           VerticalAlignment="Center" FontSize="11" Margin="16,0"/>
                
                <TextBlock Grid.Column="3" x:Name="ObsDateTimeLabel" VerticalAlignment="Center" FontSize="11"/>
            </Grid>
        </materialDesign:ColorZone>
    </Grid>
</Window>
